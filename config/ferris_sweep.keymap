#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <32 33 25 26 15 5 6 16 7 8 9 17 18 19 27 28 29>;
            hold-trigger-on-release;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };

        cap_word: cap_word {
            compatible = "zmk,behavior-caps-word";
            label = "CAP_WORD";
            #binding-cells = <0>;
            continue-list = <MINUS SPACE BACKSPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        word_cap {
            bindings = <&caps_word>;
            key-positions = <10 19>;
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            //   Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            //   A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            //   Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            //                    | LWR | SPC |   | ENT | RSE  |
            display-name = "BASE"; 
            bindings = <
  &kp Q                 &kp W                 &kp E              &kp R                   &kp T          &kp Y        &kp U                     &kp I               &kp O              &kp P
  &hrm_left LEFT_ALT A  &hrm_left LEFT_WIN S  &hrm_left LCTRL D  &hrm_left LEFT_SHIFT F  &kp G          &kp H        &hrm_right RIGHT_SHIFT J  &hrm_right RCTRL K  &hrm_right LGUI L  &hrm_right RIGHT_ALT SEMICOLON
  &kp Z                 &kp X                 &kp C              &kp V                   &kp B          &kp N        &kp M                     &kp COMMA           &kp DOT            &mt ESC SLASH
                                                                 &lt 4 TAB               &lt 1 SPACE    &lt 2 ENTER  &kp BACKSPACE
            >;
        };

        SYMBOL {
            display-name = "SYMBOL"; 
            bindings = <
  &trans  &kp ASTRK  &kp HASH     &kp DOUBLE_QUOTES  &kp AMPS    &kp UNDERSCORE  &kp DOLLAR        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION
  &trans  &kp TILDE  &kp AT       &kp SINGLE_QUOTE   &kp PLUS    &kp MINUS       &kp EQUAL         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCL
  &trans  &kp CARET  &kp PERCENT  &kp GRAVE          &kp PIPE    &kp LT          &kp GREATER_THAN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH
                                  &trans             &trans      &trans          &trans
            >;
        };

        NAV {
            display-name = "NAV"; 
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans         &kp HOME        &kp UP_ARROW  &kp END    &trans
  &trans  &trans  &trans  &trans  &trans    &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
  &trans  &trans  &trans  &trans  &trans    &kp PAGE_DOWN  &mkp MB4        &trans        &mkp MB5   &kp ESC
                          &trans  &trans    &trans         &trans
            >;
        };

        CONFIG {
            display-name = "CONFIG"; 
            bindings = <
  &kp F1      &kp F2        &kp F3        &kp F4        &kp F5          &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &kp F11  &kp F12  &trans  &trans  &trans
  &trans      &trans        &out OUT_TOG  &out OUT_USB  &out OUT_BLE    &trans   &trans   &trans  &trans  &trans
                                          &trans        &trans          &trans   &trans
            >;
        };

        NUM {
            display-name = "NUM"; 
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp COMMA
  &trans  &trans  &trans  &trans  &trans    &kp COMMA  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
  &trans  &trans  &trans  &trans  &trans    &kp DOT    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT
                          &trans  &trans    &trans     &kp DELETE
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        config {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};